{
	"name": "tskr",
	"version": "0.1.0",
	"type": "module",
	"private": true,
	"packageManager": "pnpm@10.26.1",
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"db:migrate": "prisma migrate dev",
		"db:reset": "prisma migrate reset",
		"db:sync": "prisma migrate deploy",
		"db:generate": "prisma generate",
		"db:bootstrap": "node ./scripts/db-bootstrap.cjs",
		"db:setup": "prisma migrate deploy && node ./scripts/db-bootstrap.cjs",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"i18n:supported": "node ./scripts/i18n-generate-supported.cjs",
		"i18n:sync": "pnpm i18n:supported && node ./scripts/i18n-check-static-keys.cjs && i18next-scanner --config i18next-scanner.config.cjs",
		"i18n:check": "pnpm i18n:sync && git diff --exit-code -- src/locales",
		"prebuild": "pnpm i18n:supported",
		"predev": "pnpm i18n:supported",
		"compile": "tsc --pretty",
		"test": "jest",
		"check": "node ./scripts/check.cjs",
		"prep": "node ./scripts/check.cjs --fix",
		"release:pending": "node ./scripts/release-pending.cjs",
		"release": "node ./scripts/release.cjs"
	},
	"dependencies": {
		"@js-temporal/polyfill": "^0.5.1",
		"@next-auth/prisma-adapter": "^1.0.7",
		"@prisma/adapter-better-sqlite3": "^7.3.0",
		"@prisma/client": "7.3.0",
		"@radix-ui/react-alert-dialog": "^1.1.15",
		"@radix-ui/react-avatar": "^1.1.11",
		"@radix-ui/react-dropdown-menu": "^2.1.16",
		"@radix-ui/react-label": "^2.1.8",
		"@radix-ui/react-popover": "^1.1.8",
		"@radix-ui/react-progress": "^1.1.8",
		"@radix-ui/react-select": "^2.2.6",
		"@radix-ui/react-separator": "^1.1.8",
		"@radix-ui/react-slot": "^1.2.4",
		"@radix-ui/react-switch": "^1.1.6",
		"@radix-ui/react-tabs": "^1.1.13",
		"@radix-ui/react-toast": "^1.2.15",
		"@tanstack/react-query": "^5.90.20",
		"@trpc/client": "^11.9.0",
		"@trpc/next": "^11.9.0",
		"@trpc/react-query": "^11.9.0",
		"@trpc/server": "^11.9.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.0.0",
		"framer-motion": "^12.29.3",
		"i18next": "^25.8.4",
		"i18next-pseudo": "^2.2.1",
		"i18next-resources-to-backend": "^1.2.1",
		"lucide-react": "^0.563.0",
		"next": "16.1.6",
		"next-auth": "^4.24.11",
		"next-themes": "^0.4.6",
		"prisma": "7.3.0",
		"react": "19.2.4",
		"react-dom": "19.2.4",
		"react-i18next": "^16.5.4",
		"superjson": "^2.2.6",
		"tailwind-merge": "^3.4.0",
		"web-push": "^3.6.7",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.14",
		"@tailwindcss/postcss": "^4.1.18",
		"@types/jest": "^29.5.14",
		"@types/node": "^24.1.0",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@types/web-push": "^3.6.4",
		"autoprefixer": "^10.4.24",
		"i18next-scanner": "^4.6.0",
		"jest": "^29.7.0",
		"postcss": "^8.4.49",
		"tailwindcss": "^4.1.18",
		"tailwindcss-animate": "^1.0.7",
		"ts-jest": "^29.2.5",
		"typescript": "^5"
	}
}
